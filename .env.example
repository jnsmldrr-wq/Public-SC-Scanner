# SolScan environment — copy to `.env` and fill in, OR export these in your shell.
# NEVER commit a filled-in .env (it is git-ignored). Real values are supplied
# out-of-band by the project owner.

# Etherscan API v2 key (one key works for all EVM chains via chainid=).
# Used by: evm_scan.py, shortlist/evm-eth/inventory.py, the fuzz generator's
# keyless fallback. Without it, evm_scan falls back to Blockscout (no key, but
# rate-limited and no logs). Read-only usage only.
ETHERSCAN_API_KEY=

# Optional: JSON-RPC endpoint for the local fork used by fuzz_scan.py.
# Must serve ARCHIVE/historical state (the fork is pinned to one block).
# If unset, fuzz_scan.py uses public nodes (eth.drpc.org + blastapi + mevblocker).
ETH_RPC_URL=

# Optional overrides for the EVM/Slither toolchain (see HANDOVER.md §Setup):
# SOLSCAN_EVM_PYTHON=/path/to/.venv-evm/bin/python
# SOLSCAN_SOLC_SELECT=/path/to/solc-select
# SOLSCAN_EVM_WORKDIR=/path/to/workdir
